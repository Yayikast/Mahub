{
  "installCommand": "npm ci --prefix client && npm ci --prefix server",
  "buildCommand": "npm run build:mock --prefix client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": { "includeFiles": "server/certs/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/auth/(.*)", "destination": "/api" },
    { "source": "/scan", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

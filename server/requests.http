########################################################################
### #13  SECTIONS (admin)  - sign in as the admin first
########################################################################

### List sections: 200, 3 rows with course_code, course_name and instructor_name
GET {{base}}/api/sections

### Create a section (CSS325, Boeing, a term far away): 201 in the same shape as the list
# @name newSection
POST {{base}}/api/sections
Content-Type: application/json

{ "course_id": 2, "instructor_id": {{boeing}}, "term": " 2099-1 ", "section_no": 1 }

### The same course, term and section number: 409 { "error": "That course, term and section number already exist" }
POST {{base}}/api/sections
Content-Type: application/json

{ "course_id": 2, "instructor_id": {{yayika}}, "term": "2099-1", "section_no": 1 }

### instructor_id is the admin: 400 { "error": "instructor_id must be a user with the instructor role" }
POST {{base}}/api/sections
Content-Type: application/json

{ "course_id": 2, "instructor_id": {{admin}}, "term": "2099-1", "section_no": 5 }

### instructor_id is a student: 400 (same message)
POST {{base}}/api/sections
Content-Type: application/json

{ "course_id": 2, "instructor_id": {{student1}}, "term": "2099-1", "section_no": 5 }

### A course that does not exist: 400 { "error": "That course does not exist" }
POST {{base}}/api/sections
Content-Type: application/json

{ "course_id": 99999, "instructor_id": {{boeing}}, "term": "2099-1", "section_no": 5 }

### No term: 400 { "error": "Term is required" }
POST {{base}}/api/sections
Content-Type: application/json

{ "course_id": 2, "instructor_id": {{boeing}}, "term": "", "section_no": 5 }

### Section number 0: 400 { "error": "Section number must be a whole number from 1 to 999" }
POST {{base}}/api/sections
Content-Type: application/json

{ "course_id": 2, "instructor_id": {{boeing}}, "term": "2099-1", "section_no": 0 }

### Edit the section number and the teacher: 200
PUT {{base}}/api/sections/{{newSection.response.body.$.id}}
Content-Type: application/json

{ "section_no": 2, "instructor_id": {{yayika}} }

### Edit it into CSS326, 2026-1, section 1, which exists: 409 { "error": "That course, term and section number already exist" }
PUT {{base}}/api/sections/{{newSection.response.body.$.id}}
Content-Type: application/json

{ "course_id": 1, "term": "2026-1", "section_no": 1 }

### Edit the teacher to the admin: 400 { "error": "instructor_id must be a user with the instructor role" }
PUT {{base}}/api/sections/{{newSection.response.body.$.id}}
Content-Type: application/json

{ "instructor_id": {{admin}} }

### Nothing to change: 400 { "error": "Nothing to change" }
PUT {{base}}/api/sections/{{newSection.response.body.$.id}}
Content-Type: application/json

{}

### A section that does not exist: 404 { "error": "Section not found" }
PUT {{base}}/api/sections/99999
Content-Type: application/json

{ "term": "2099-2" }

### Delete CSS326-1, which has sessions: 409 { "error": "This section still has sessions" }
DELETE {{base}}/api/sections/{{css326s1}}

### Delete CSS325-1, which has students but no sessions: 409 { "error": "This section still has enrolled students" }
DELETE {{base}}/api/sections/{{css325s1}}

### Delete the new section: 200 { "ok": true }
DELETE {{base}}/api/sections/{{newSection.response.body.$.id}}

### The same section again: 404 { "error": "Section not found" }
DELETE {{base}}/api/sections/{{newSection.response.body.$.id}}


########################################################################
### #13  CAMPUSES  - the list is for the admin AND instructors
########################################################################

### List campuses as the admin: 200, 2 rows (Rangsit, Bangkadi), lat and lng are numbers
GET {{base}}/api/campuses

### Create a campus: 201
# @name newCampus
POST {{base}}/api/campuses
Content-Type: application/json

{ "name": " Requests Campus ", "lat": 13.5, "lng": 100.5, "radius_m": 250 }

### The same name: 409 { "error": "That campus name already exists" }
POST {{base}}/api/campuses
Content-Type: application/json

{ "name": "Requests Campus", "lat": 13.5, "lng": 100.5, "radius_m": 250 }

### lat out of range: 400 { "error": "lat must be a number from -90 to 90" }
POST {{base}}/api/campuses
Content-Type: application/json

{ "name": "Requests Bad Lat", "lat": 91, "lng": 100.5, "radius_m": 250 }

### lng out of range: 400 { "error": "lng must be a number from -180 to 180" }
POST {{base}}/api/campuses
Content-Type: application/json

{ "name": "Requests Bad Lng", "lat": 13.5, "lng": -181, "radius_m": 250 }

### radius_m too small: 400 { "error": "radius_m must be a whole number from 10 to 5000" }
POST {{base}}/api/campuses
Content-Type: application/json

{ "name": "Requests Bad Radius", "lat": 13.5, "lng": 100.5, "radius_m": 5 }

### No name: 400 { "error": "Campus name is required" }
POST {{base}}/api/campuses
Content-Type: application/json

{ "name": " ", "lat": 13.5, "lng": 100.5, "radius_m": 250 }

### Edit the radius: 200, the other fields stay the same
PUT {{base}}/api/campuses/{{newCampus.response.body.$.id}}
Content-Type: application/json

{ "radius_m": 400 }

### Edit the name to Rangsit: 409 { "error": "That campus name already exists" }
PUT {{base}}/api/campuses/{{newCampus.response.body.$.id}}
Content-Type: application/json

{ "name": "Rangsit" }

### A campus that does not exist: 404 { "error": "Campus not found" }
PUT {{base}}/api/campuses/99999
Content-Type: application/json

{ "radius_m": 400 }

### Delete Rangsit, where sessions happened: 409 { "error": "A session uses this campus" }
DELETE {{base}}/api/campuses/1

### Delete the new campus: 200 { "ok": true }
DELETE {{base}}/api/campuses/{{newCampus.response.body.$.id}}

### The same campus again: 404 { "error": "Campus not found" }
DELETE {{base}}/api/campuses/{{newCampus.response.body.$.id}}

### Now sign in as Boeing (an instructor), then:
### an instructor can read the list: 200
GET {{base}}/api/campuses

### but cannot add one: 403

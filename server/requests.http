{ "name": "Not Allowed", "lat": 13.5, "lng": 100.5, "radius_m": 250 }

### or change one: 403
PUT {{base}}/api/campuses/1
Content-Type: application/json

{ "radius_m": 10 }

### or delete one: 403
DELETE {{base}}/api/campuses/2

### Sign in as Student 1, then the list is 403 too
GET {{base}}/api/campuses


########################################################################
### #13  ENROLLMENTS
### Clean-up if you run this block twice: the single add/remove below undo each other,
### but the import adds Student 25 to CSS326-1; remove it with the last request of this block.
########################################################################

### Sign in as the admin. List section 1: 200, 20 students, each with created_by and created_at
GET {{base}}/api/sections/{{css326s1}}/enrollments

### Add Student 30 (not in section 1): 201 { student_id: 33, full_name, email, student_no, created_by: 1, created_at }
POST {{base}}/api/sections/{{css326s1}}/enrollments
Content-Type: application/json

{ "student_id": {{student30}} }

### The same student again: 409 { "error": "Already enrolled" }
POST {{base}}/api/sections/{{css326s1}}/enrollments
Content-Type: application/json

{ "student_id": {{student30}} }

### The admin is not a student: 400 { "error": "Choose a student" }
POST {{base}}/api/sections/{{css326s1}}/enrollments
Content-Type: application/json

{ "student_id": {{admin}} }

### A user that does not exist: 400 { "error": "Choose a student" }
POST {{base}}/api/sections/{{css326s1}}/enrollments
Content-Type: application/json

{ "student_id": 99999 }

### No student_id: 400 { "error": "student_id must be a user id" }
POST {{base}}/api/sections/{{css326s1}}/enrollments
Content-Type: application/json

{}

### A section that does not exist: 404 { "error": "Section not found" }
POST {{base}}/api/sections/99999/enrollments
Content-Type: application/json

{ "student_id": {{student30}} }

### List a section that does not exist: 404 { "error": "Section not found" }
GET {{base}}/api/sections/99999/enrollments

### Remove Student 30 again: 200 { "ok": true }
DELETE {{base}}/api/sections/{{css326s1}}/enrollments/{{student30}}

### The same removal again: 404 { "error": "Enrollment not found" }
DELETE {{base}}/api/sections/{{css326s1}}/enrollments/{{student30}}

### Check the audit log: GET /api/audit?type=enrollment shows an INSERT then a DELETE,
### both with section_id 1, student_id 33 and changed_by 1. (The failed requests above add nothing.)
GET {{base}}/api/audit?type=enrollment&limit=5

### Now sign in as Boeing (teaches section 1).
### His own section: 200, 20 students and NO created_by or created_at
GET {{base}}/api/sections/{{css326s1}}/enrollments

### Yayika's section: 403 { "error": "Not your section" }
GET {{base}}/api/sections/{{css326s2}}/enrollments

### An instructor cannot add a student: 403
POST {{base}}/api/sections/{{css326s1}}/enrollments
Content-Type: application/json

{ "student_id": {{student30}} }

### An instructor cannot remove a student: 403
DELETE {{base}}/api/sections/{{css326s1}}/enrollments/{{student1}}

### Sign in as Yayika. Boeing's section: 403 { "error": "Not your section" }
GET {{base}}/api/sections/{{css326s1}}/enrollments


########################################################################
### #13  ENROLLMENT IMPORT  (admin or the teacher of the section)
########################################################################

### Sign in as Boeing. Dry run on section 1: 200, nothing saved.
###   row 1 enroll (Student 25 is in section 2 only), row 2 already_enrolled,
###   row 3 problem not_a_user (instructors never create users)
###   totals { enroll: 1, new_user: 0, already_enrolled: 1, problem: 1 }
POST {{base}}/api/sections/{{css326s1}}/enrollments/import
Content-Type: application/json

{ "dry_run": true,
  "rows": [
    { "email": "student25@g.siit.tu.ac.th" },
    { "email": "student1@g.siit.tu.ac.th" },
    { "email": "nobody@g.siit.tu.ac.th", "full_name": "Nobody" }
  ] }

### Real run with that problem row: 400 { "error": "Nothing was saved: 1 row has a problem", ... }
### Student 25 must still NOT be in section 1 afterwards.
POST {{base}}/api/sections/{{css326s1}}/enrollments/import
Content-Type: application/json

{ "dry_run": false,
  "rows": [
    { "email": "student25@g.siit.tu.ac.th" },

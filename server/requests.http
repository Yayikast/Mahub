########################################################################
### #13  AUDIT LOG (admin)
########################################################################

### Everything, newest first: 200, at most 100 rows, each with a type
GET {{base}}/api/audit

### Only 5 rows: 200
GET {{base}}/api/audit?limit=5

### Only enrollment changes: 200, every row has type "enrollment" and only
### id, type, action, section_id, student_id, changed_by, changed_at
GET {{base}}/api/audit?type=enrollment

### Only imports: 200, every row has type "import", section_id and a summary
GET {{base}}/api/audit?type=import

### Only attendance changes: 200, with session_id, old_status and new_status
GET {{base}}/api/audit?type=attendance&limit=3

### limit 0: 400 { "error": "limit must be a whole number from 1 to 500" }
GET {{base}}/api/audit?limit=0

### limit 501: 400 (same message)
GET {{base}}/api/audit?limit=501

### A type that does not exist: 400 { "error": "type must be attendance, enrollment or import" }
GET {{base}}/api/audit?type=other

### Sign in as Boeing: the audit log is for the admin only, 403
GET {{base}}/api/audit


########################################################################
### #17  SESSIONS (instructors only, own sections only)
### Sign in as Boeing for this whole block (he teaches section 1 and 3).
### Every run opens a new session and closes it again. To start from the seed:
###   DELETE FROM attendance WHERE session_id > 3;
###   DELETE FROM checkin_attempts WHERE session_id > 3;
###   DELETE FROM class_sessions WHERE id > 3;
########################################################################

### My sections: 200, 2 rows (CSS326-1 and CSS325-1) with id, course_code, course_name, term, section_no
GET {{base}}/api/my/sections

### Sessions of CSS326-1: 200, the 3 seeded ones, newest first. Each has opened_at, closed_at,
### present_count, excused_count and enrolled_count (20); present + excused never passes enrolled
GET {{base}}/api/sections/{{css326s1}}/sessions

### CSS325-1 has no sessions yet: 200 []
GET {{base}}/api/sections/{{css325s1}}/sessions

### A section that does not exist: 404 { "error": "Section not found" }
GET {{base}}/api/sections/99999/sessions

### An id that is not a number: 404
GET {{base}}/api/sections/abc/sessions

### Start a check-in at Rangsit: 201 { id, section_id: 1, campus_id: 1, opened_at }
# @name openSession
POST {{base}}/api/sections/{{css326s1}}/sessions
Content-Type: application/json

{ "campus_id": 1 }

### Start another while one is open: 409 { "error": "A session is already open for this section" }
POST {{base}}/api/sections/{{css326s1}}/sessions
Content-Type: application/json

{ "campus_id": 1 }

### No campus: 400 { "error": "Choose a campus" }
POST {{base}}/api/sections/{{css325s1}}/sessions
Content-Type: application/json

{}

### A campus that does not exist: 400 { "error": "Choose a campus" }
POST {{base}}/api/sections/{{css325s1}}/sessions
Content-Type: application/json

{ "campus_id": 99999 }

### A section that does not exist: 404 { "error": "Section not found" }
POST {{base}}/api/sections/99999/sessions
Content-Type: application/json

{ "campus_id": 1 }

### The QR link: 200 { scan_url: ".../scan?s=<id>&c=<6 hex characters>", expires_at }.
### Run it again straight away: the SAME code and expires_at. Wait 10 seconds and run it again: a NEW code.
### (Two pages polling at the same moment always see the same code.)
GET {{base}}/api/sessions/{{openSession.response.body.$.id}}/qr

### A session that does not exist: 404 { "error": "Session not found" }
GET {{base}}/api/sessions/99999/qr

### An id that is not a number: 404
GET {{base}}/api/sessions/abc/qr


########################################################################
### #18  ROSTER, MARKS AND ATTEMPTS  (Boeing, the session opened above)
########################################################################

### The roster of the open session: 200, is_open true, closed_at null,
### section { id: 1, course_code: "CSS326", ... }, campus { id: 1, name: "Rangsit" },
### counts { present: 0, excused: 0, absent: 20, total: 20 }, 20 students sorted by student_no,
### each absent with method null and recorded_at null
GET {{base}}/api/sessions/{{openSession.response.body.$.id}}/roster

### Mark Student 1 present (a dead phone): 200 { student_id: 4, status: "present", method: "manual" }
PUT {{base}}/api/sessions/{{openSession.response.body.$.id}}/attendance/{{student1}}
Content-Type: application/json

{ "status": "present" }

### The roster again: counts { present: 1, excused: 0, absent: 19, total: 20 }, Student 1 is present / manual
GET {{base}}/api/sessions/{{openSession.response.body.$.id}}/roster

### Change Student 1 to excused: 200 { student_id: 4, status: "excused", method: "manual" }
PUT {{base}}/api/sessions/{{openSession.response.body.$.id}}/attendance/{{student1}}
Content-Type: application/json

{ "status": "excused" }

### Absent is not a status you can set (clear the mark instead): 400 { "error": "Status must be present or excused" }
PUT {{base}}/api/sessions/{{openSession.response.body.$.id}}/attendance/{{student1}}
Content-Type: application/json

{ "status": "absent" }

### No status: 400 { "error": "Status must be present or excused" }
PUT {{base}}/api/sessions/{{openSession.response.body.$.id}}/attendance/{{student1}}
Content-Type: application/json

{}

### Student 30 is not in section 1: 404 { "error": "That student is not enrolled in this section" }
PUT {{base}}/api/sessions/{{openSession.response.body.$.id}}/attendance/{{student30}}
Content-Type: application/json

{ "status": "present" }

### The admin is not a student: 404 (same message)
PUT {{base}}/api/sessions/{{openSession.response.body.$.id}}/attendance/{{admin}}
Content-Type: application/json

{ "status": "present" }

### A user that does not exist: 404
PUT {{base}}/api/sessions/{{openSession.response.body.$.id}}/attendance/99999
Content-Type: application/json

{ "status": "present" }

### A session that does not exist: 404 { "error": "Session not found" }
PUT {{base}}/api/sessions/99999/attendance/{{student1}}
Content-Type: application/json

{ "status": "present" }

### Attempts: 200 [] for now. Attempts are written by POST /api/checkin (#21), so to see rows,
### add some in the SQL editor (use the session id from the open request, and two student ids):
###   INSERT INTO checkin_attempts (session_id, user_id, outcome, distance_m, accuracy_m) VALUES
###     (<session id>, 5, 'too_far', 950, 18), (<session id>, 6, 'closed', NULL, NULL), (<session id>, 5, 'ok', 40, 12);
### Then 200, 3 rows NEWEST FIRST (ok, closed, too_far), each with id, user_id, full_name, outcome,
### distance_m (null for "closed"), accuracy_m and created_at
GET {{base}}/api/sessions/{{openSession.response.body.$.id}}/attempts

### Clear Student 1's mark: 200 { "ok": true }, and the roster shows absent again
DELETE {{base}}/api/sessions/{{openSession.response.body.$.id}}/attendance/{{student1}}

### The same again: 404 { "error": "There was no mark to clear" }
DELETE {{base}}/api/sessions/{{openSession.response.body.$.id}}/attendance/{{student1}}

### An id that is not a number: 404
DELETE {{base}}/api/sessions/{{openSession.response.body.$.id}}/attendance/abc

### Mark Student 2 present once more, so the closed roster has something to show: 200
PUT {{base}}/api/sessions/{{openSession.response.body.$.id}}/attendance/5
Content-Type: application/json

{ "status": "present" }



# Copy this file to .env and fill in the values. Never commit .env.
# Ask Yayika for the values privately (password manager), never in chat.

# Supabase: Connect -> Transaction pooler (port 6543)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Signs the login cookie. Make one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Cloud Console -> Credentials -> OAuth client "Mahub web"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev login (POST /auth/dev-login, GET /auth/dev-users): local only, never on Vercel.
# Without it those routes don't exist (404). On Vercel they stay off even if set.
DEV_LOGIN=1
